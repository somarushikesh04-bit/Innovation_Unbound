# MSME360 Environment Configuration
SECRET_KEY=replace-with-secure-random-secret
JWT_SECRET_KEY=replace-with-secure-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# Database
DATABASE_URL=sqlite:///msme360.db

# API & Security
FLASK_ENV=development
PORT=5000
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=uploads

# Stitch / Gemini AI Integration
STITCH_API_KEY=your-stitch-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
